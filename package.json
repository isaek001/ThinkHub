{
  "name": "thinkhub-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ThinkHub public website + admin portal. React (Vite) frontend, zero-dependency Node API.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server.js",
    "serve": "npm run build && node server.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
